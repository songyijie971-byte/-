# Copy to your own .env or export these variables in your shell.
# Docker Compose auto-loads .env for the values below.

# Docker Compose secrets (replace before sharing or deploying)
MYSQL_ROOT_PASSWORD=change-root-password
MYSQL_APP_USER=classroom_user
MYSQL_APP_PASSWORD=change-app-password
DEFAULT_ADMIN_PASSWORD=change-admin-password

# Database (choose one)
DATABASE_URL=sqlite:///classroom_demo.db
# DATABASE_URL=mysql+pymysql://user:pass@127.0.0.1:3306/classroom_demo?charset=utf8mb4

# MySQL fallback (used only when DATABASE_URL is not set)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=classroom_demo
MYSQL_CHARSET=utf8mb4

# Model + uploads
YOLO_MODEL_PATH=best.onnx
YOLO_CONFIDENCE=0.20
# local | roboflow. If ROBOFLOW_API_KEY is present and this is not set, the app auto-uses roboflow.
INFERENCE_PROVIDER=local
# Emergency high-recall hosted model for phone / raise hand / sleep.
# INFERENCE_PROVIDER=roboflow
# ROBOFLOW_API_KEY=your-roboflow-api-key
# ROBOFLOW_MODEL_ID=new-student-classroom-activity-3-hand-raise-phone-sleep-2-x63gb-6j0xy/6
# ROBOFLOW_CONFIDENCE=0.15
# ROBOFLOW_OVERLAP=0.45
# ROBOFLOW_TIMEOUT_SECONDS=20
UPLOAD_DIR=data/uploads
MAX_UPLOAD_SIZE_MB=200

# Camera
CAMERA_INDEX=0
CAMERA_BACKEND=auto

# Runtime
STREAM_FPS=12
INFERENCE_EVERY_N_FRAMES=2
INFERENCE_MIN_INTERVAL_SECONDS=0.35
VIDEO_ANALYSIS_FRAME_STRIDE=3

# Background job executor: thread | process | queue
JOB_EXECUTOR_BACKEND=thread
JOB_EXECUTOR_PROCESS_WORKERS=2
JOB_QUEUE_DIR=data/job_queue
JOB_QUEUE_POLL_SECONDS=1.0

# Security
# FLASK_SECRET_KEY=change-me
# FLASK_SECRET_KEY_FILE=data/runtime/flask_secret_key.txt
# SESSION_COOKIE_SECURE=true

# Logging
LOG_LEVEL=INFO

# Tests (optional)
# Only used by unittest; when not set, MySQL integration tests will be skipped.
# TEST_DATABASE_URL=mysql+pymysql://user:pass@127.0.0.1:3306/classroom_demo?charset=utf8mb4
